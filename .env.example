# Copy to server/.env and web/.env and fill in. Nothing here is committed.

# ---------- server/.env ----------
PORT=8787
# Where the SQLite cache file lives
DATABASE_FILE=./data/catalog.sqlite

# Meta / Facebook Commerce Catalog (source of truth). Leave BOTH blank for mock mode.
# META_CATALOG_ID   e.g. 1234567890123456
#   Commerce Manager > catalog > Settings > "Catalog ID"
# META_ACCESS_TOKEN  e.g. EAAG...
#   Business Settings > System users > Generate token (never-expiring, catalog_management)
META_CATALOG_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# How often to pull the catalog (cron expression). Default: every 15 minutes.
SYNC_CRON=*/15 * * * *
# Shared secret required by POST /api/sync
SYNC_SECRET=change-me

# Free machine translation of catalog text, used only when the shopper's browser
# can't translate the page itself. Provider: MyMemory (no key needed).
TRANSLATE_ENABLED=true
TRANSLATE_TARGET_LANG=ar
# Optional email — raises MyMemory's free daily word limit (5k -> 50k words).
TRANSLATE_EMAIL=

# Public shop config served to the storefront at GET /api/config
SHOP_NAME=Zuzu Kitchen Equipment
SHOP_CURRENCY=MAD
SHOP_LOCALE=en
# WhatsApp Business number in international format, digits only (no +, spaces or dashes)
SHOP_WHATSAPP_NUMBER=212600000000

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ---------- web/.env ----------
# Only needed to override the dev proxy target; production is same-origin.
VITE_API_TARGET=http://localhost:8787
